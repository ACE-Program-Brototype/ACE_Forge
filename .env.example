# ==============================================================================
# ACE FORGE FRONTEND ENVIRONMENT CONFIGURATION (Next.js)
# Copy this file to .env.local or .env for local frontend development.
# When deploying the frontend to Vercel, set these in Vercel Project Settings.
# ==============================================================================

# Backend API URL
# In local development, the Express backend server runs on http://localhost:4000
# In production on Vercel, set this to your hosted backend URL (e.g., https://your-backend.onrender.com)
BACKEND_API_URL="http://localhost:4000"
NEXT_PUBLIC_API_URL="http://localhost:4000"

# Authentication & Security
# MUST match the JWT_SECRET in your backend server so Next.js middleware can verify auth cookies
JWT_SECRET="ace-forge-super-secret-development-jwt-key-2026-very-secure"
JWT_EXPIRES_IN="7d"



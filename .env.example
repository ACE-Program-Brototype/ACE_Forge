# ==============================================================================
# ACE FORGE ENVIRONMENT CONFIGURATION
# Copy this file to .env and adjust the values according to your environment.
# ==============================================================================

# Database Connection (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://localhost:5432/ace_forge"

# Authentication & Security
# Generate a strong 32+ character random string for production
JWT_SECRET="ace-forge-super-secret-development-jwt-key-2026-very-secure"
JWT_EXPIRES_IN="7d"

# Initial Super Admin Seed Credentials
# Used by prisma/seed.ts to initialize the root SUPER_ADMIN
SUPER_ADMIN_NAME="ACE Director"
SUPER_ADMIN_EMAIL="director@aceprogram.org"
SUPER_ADMIN_PASSWORD="SuperSecretAdminPassword123!"

# Application Base URL
APP_BASE_URL="http://localhost:3000"

# Email Configuration (Nodemailer)
# When EMAIL_DEV_MODE is "true", emails will be printed to the server console
# and logged to the EmailLog database table instead of sending through real SMTP.
EMAIL_DEV_MODE="true"
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="ACE Forge <noreply@aceprogram.org>"

# Google Gemini AI Review Configuration
# Required for automated report code review & AI likelihood scoring
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-flash-latest"

# Anthropic Claude AI Review Configuration (Optional legacy fallback)
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-3-5-sonnet-20241022"

# GitHub REST API Token (Optional)
# Increases GitHub API rate limits from 60 req/hr to 5,000 req/hr and enables
# access to private coursework repositories if granted scope.
GITHUB_TOKEN=""


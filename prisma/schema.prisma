generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
}

enum BatchStatus {
  ACTIVE
  COMPLETED
}

enum StudentStatus {
  ACTIVE
  INACTIVE
}

enum StudentTaskStatus {
  ASSIGNED
  SUBMITTED
  REVIEWED
  OVERDUE
}

enum ReportStatus {
  SUBMITTED
  AI_REVIEWED
  FINALIZED
}

enum FeedbackType {
  AI
  EMPLOYEE
}

enum EmailType {
  WELCOME
  REMINDER_DAY6
  OTHER
}

enum EmailStatus {
  SENT
  FAILED
}

model Admin {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         Role      @default(ADMIN)
  isActive     Boolean   @default(true)
  createdById  String?
  createdBy    Admin?    @relation("AdminCreatedAdmins", fields: [createdById], references: [id], onDelete: SetNull)
  createdAdmins Admin[]  @relation("AdminCreatedAdmins")

  createdStudents Student[] @relation("AdminCreatedStudents")
  createdTasks    Task[]    @relation("AdminCreatedTasks")
  reviews         Feedback[] @relation("AdminFeedbackReviews")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([role])
  @@index([isActive])
}

model Batch {
  id        String      @id @default(cuid())
  name      String      @unique
  startDate DateTime
  status    BatchStatus @default(ACTIVE)

  students Student[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([status])
}

model Module {
  id          String   @id @default(cuid())
  name        String
  orderIndex  Int
  description String

  tasks    Task[]
  students Student[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderIndex])
}

model Student {
  id                 String        @id @default(cuid())
  name               String
  email              String        @unique
  phone              String
  passwordHash       String
  batchId            String
  batch              Batch         @relation(fields: [batchId], references: [id], onDelete: Restrict)
  currentModuleId    String
  currentModule      Module        @relation(fields: [currentModuleId], references: [id], onDelete: Restrict)
  status             StudentStatus @default(ACTIVE)
  mustChangePassword Boolean       @default(true)
  createdById        String?
  createdBy          Admin?        @relation("AdminCreatedStudents", fields: [createdById], references: [id], onDelete: SetNull)

  studentTasks StudentTask[]
  reports      Report[]
  feedbacks    Feedback[]
  emailLogs    EmailLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([batchId])
  @@index([currentModuleId])
  @@index([status])
}

model Task {
  id            String   @id @default(cuid())
  title         String
  description   String
  referenceLink String?
  moduleId      String
  module        Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  isActive      Boolean  @default(true)
  createdById   String?
  createdBy     Admin?   @relation("AdminCreatedTasks", fields: [createdById], references: [id], onDelete: SetNull)

  studentTasks StudentTask[]
  reports      Report[]
  feedbacks    Feedback[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([moduleId])
  @@index([isActive])
}

model StudentTask {
  id             String            @id @default(cuid())
  studentId      String
  student        Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  taskId         String
  task           Task              @relation(fields: [taskId], references: [id], onDelete: Cascade)
  assignedAt     DateTime          @default(now())
  dueAt          DateTime
  reminderSentAt DateTime?
  status         StudentTaskStatus @default(ASSIGNED)

  report    Report?
  emailLogs EmailLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, taskId])
  @@index([studentId])
  @@index([taskId])
  @@index([status])
  @@index([dueAt])
  @@index([reminderSentAt])
}

model Report {
  id                    String       @id @default(cuid())
  studentTaskId         String       @unique
  studentTask           StudentTask  @relation(fields: [studentTaskId], references: [id], onDelete: Cascade)
  studentId             String
  student               Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  taskId                String
  task                  Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  githubRepoUrl         String
  title                 String
  description           String
  aiDeclarationAccepted Boolean
  status                ReportStatus @default(SUBMITTED)
  finalMarks            Int?
  submittedAt           DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  feedbacks Feedback[]

  @@index([studentId])
  @@index([taskId])
  @@index([status])
  @@index([studentTaskId])
}

model Feedback {
  id              String       @id @default(cuid())
  reportId        String
  report          Report       @relation(fields: [reportId], references: [id], onDelete: Cascade)
  taskId          String
  task            Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  studentId       String
  student         Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  type            FeedbackType
  marks           Int
  comments        String
  strengths       String[]     @default([])
  improvements    String[]     @default([])
  reviewerAdminId String?
  reviewerAdmin   Admin?       @relation("AdminFeedbackReviews", fields: [reviewerAdminId], references: [id], onDelete: SetNull)
  aiModel         String?
  repoSnapshot    Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([reportId, type])
  @@index([reportId])
  @@index([studentId])
  @@index([taskId])
  @@index([type])
}

model EmailLog {
  id            String       @id @default(cuid())
  studentId     String?
  student       Student?     @relation(fields: [studentId], references: [id], onDelete: SetNull)
  studentTaskId String?
  studentTask   StudentTask? @relation(fields: [studentTaskId], references: [id], onDelete: SetNull)
  type          EmailType
  status        EmailStatus
  error         String?
  sentAt        DateTime     @default(now())

  @@index([studentId])
  @@index([studentTaskId])
  @@index([type])
  @@index([status])
}
